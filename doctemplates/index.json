 "mbp1_dir8": {
  "id": "mbp1_dir8",
  "title": "Form MBP-1 and DIR-8 (per director)",
  "category": "Company records",
  "description": "Disclosure of interest (MBP-1) and intimation of non-disqualification (DIR-8) for one director.",
  "fields": [
   {
    "key": "director",
    "label": "Director",
    "type": "director"
   },
   {
    "key": "date",
    "label": "Date",
    "type": "date",
    "default": "fy_end_next",
    "fmt": "dots"
   },
   {
    "key": "sign_place",
    "label": "Place",
    "type": "text",
    "default": "reg_city"
   },
   {
    "key": "interests",
    "label": "MBP-1: entities in which the director is interested",
    "type": "list",
    "columns": [
     {
      "key": "company",
      "label": "Name of company / body corporate / firm",
      "type": "text"
     },
     {
      "key": "nature",
      "label": "Nature of interest",
      "type": "text"
     },
     {
      "key": "holding",
      "label": "Shareholding (No. & %)",
      "type": "text"
     },
     {
      "key": "since",
      "label": "Date interest arose",
      "type": "date"
     }
    ]
   },
   {
    "key": "directorships",
    "label": "DIR-8: directorships in the last 3 years",
    "type": "list",
    "columns": [
     {
      "key": "company",
      "label": "Name of company",
      "type": "text"
     },
     {
      "key": "since",
      "label": "Original date of appointment",
      "type": "date"
     },
     {
      "key": "ceased",
      "label": "Date of cessation",
      "type": "date"
     }
    ]
   },
   {
    "key": "disq",
    "label": "Disqualified under s.164(2)?",
    "type": "select",
    "options": [
     "no",
     "yes"
    ],
    "default": "no"
   }
  ],
  "repeats": [
   {
    "table": 0,
    "row": 1,
    "source": "interests",
    "cols": [
     "#",
     "company",
     "nature",
     "holding",
     "since@date"
    ]
   },
   {
    "table": 1,
    "row": 1,
    "source": "directorships",
    "cols": [
     "#",
     "company",
     "since@date",
     "ceased@date"
    ]
   }
  ],
  "conditions": [
   {
    "field": "disq",
    "equals": "no",
    "default": "no",
    "delete": [
     53,
     54,
     55,
     56,
     57,
     58,
     59
    ]
   },
   {
    "field": "disq",
    "equals": "yes",
    "delete": [
     51,
     52,
     53
    ]
   }
  ],
  "heading_style": "num",
  "slots_order": [
   "main"
  ]
 },
